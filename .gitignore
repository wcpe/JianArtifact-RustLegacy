# Rust 构建产物（硬约束：宿主项目目录不得出现 target）
/target/

# Node 构建产物与依赖（硬约束：宿主项目目录不得出现 node_modules）
**/node_modules/
dist/
build/
.cache/
*.tsbuildinfo

# Turborepo 缓存
.turbo/

# pnpm 内容寻址存储（容器内经命名卷承接）
/.pnpm-store/

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# IDE / 操作系统
/.idea/
.vscode/
.DS_Store
Thumbs.db

# 过程性文档与临时文件（不入库）
/.tmp/

# 环境与密钥（不入库）；.env.example 是无真实值的模板，必须入库
.env
.env.*
!.env.example

# MSW 浏览器 worker（构建期由 msw init 生成，第三方生成文件不入库）
apps/devmock/public/

# 本地数据：SQLite 元数据库与 blob 数据目录
*.db
*.db-wal
*.db-shm
/data/

# 构建与测试临时产物
coverage/
