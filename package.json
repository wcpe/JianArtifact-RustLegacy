{
  "name": "jianartifact",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,css,html,json}\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,css,html,json}\""
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "^2.5.0"
  }
}
