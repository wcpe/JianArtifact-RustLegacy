{
  "name": "@jianartifact/devmock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./node": "./src/node.ts",
    "./scenarios": "./src/scenarios.ts",
    "./schema": "./src/schema.d.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "build": "rm -rf public && msw init public && vite build",
    "generate:schema": "openapi-typescript openapi.json -o src/schema.d.ts"
  },
  "dependencies": {
    "msw": "^2.0.0"
  },
  "devDependencies": {
    "@jianartifact/eslint-config": "workspace:*",
    "@jianartifact/typescript-config": "workspace:*",
    "eslint": "^9.0.0",
    "openapi-typescript": "^7.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
