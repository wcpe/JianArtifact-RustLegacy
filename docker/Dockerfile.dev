# JianArtifact 统一开发与质量门镜像
# 单一镜像同时提供 Rust 与前端工具链，保证本地与 CI 使用完全相同的环境。
# 硬约束：宿主机不得直接运行 cargo/pnpm/npm，一切构建、测试、检查均在本镜像容器内执行。
FROM rust:1.96.1-bookworm

ARG JDK_VERSION=17.0.14_7
ARG JDK_SHA256=a3af83983fb94dd7d11b13ba2dba0fb6819dc2caaf87e6937afd22ad4680ae9a
ARG MAVEN_VERSION=3.9.9
ARG MAVEN_SHA512=a555254d6b53d267965a3404ecb14e53c3827c09c3b94b5678835887ab404556bfaf78dcfe03ba76fa2508649dca8531c74bca4d5846513522404d48e8c4ac8b

ENV JAVA_HOME=/opt/java/openjdk \
    MAVEN_HOME=/opt/maven \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
ENV PATH="${JAVA_HOME}/bin:${MAVEN_HOME}/bin:${PATH}"

# 一层安装固定客户端工具链及 Playwright 依赖，下载归档均校验摘要后解包。
RUN rustup component add rustfmt clippy \
    && cargo install cargo-audit --locked \
    && cargo install cargo-deny --locked \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && mkdir -p "${JAVA_HOME}" "${MAVEN_HOME}" \
    && curl -fsSL "https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.14%2B7/OpenJDK17U-jdk_x64_linux_hotspot_${JDK_VERSION}.tar.gz" -o /tmp/jdk.tar.gz \
    && echo "${JDK_SHA256}  /tmp/jdk.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/jdk.tar.gz --strip-components=1 -C "${JAVA_HOME}" \
    && curl -fsSL "https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz" -o /tmp/maven.tar.gz \
    && echo "${MAVEN_SHA512}  /tmp/maven.tar.gz" | sha512sum -c - \
    && tar -xzf /tmp/maven.tar.gz --strip-components=1 -C "${MAVEN_HOME}" \
    && corepack enable \
    && corepack prepare pnpm@9.15.9 --activate \
    && npx --yes playwright@1.49.1 install --with-deps chromium \
    && rm -f /tmp/jdk.tar.gz /tmp/maven.tar.gz \
    && rm -rf /var/lib/apt/lists/* /root/.npm

# 统一工作目录：docker-compose 将项目根挂载到此处
WORKDIR /workspace
