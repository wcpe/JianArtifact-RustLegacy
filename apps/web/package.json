{
  "name": "@jianartifact/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "predev": "msw init public --no-save",
    "dev": "vite",
    "pretest:e2e": "msw init public --no-save",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config playwright.real.config.ts",
    "build": "vite build"
  },
  "dependencies": {
    "@jianartifact/ui": "workspace:*",
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@jianartifact/devmock": "workspace:*",
    "@jianartifact/eslint-config": "workspace:*",
    "@playwright/test": "1.49.1",
    "@jianartifact/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "msw": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
