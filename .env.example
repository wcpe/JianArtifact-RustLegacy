# JianArtifact 部署配置模板（M1-FR-043）。
# 用法：复制为 .env 并填入真实值；.env 已被 .gitignore 排除，严禁提交入库。
# 注意：值不要包含单引号。

# 目标机地址（必填），IP 或主机名
DEPLOY_HOST=

# 目标机上的部署用户（必填）；rootless 部署，该用户无需任何 sudo 权限。
# 一次性前置：需管理员在目标机执行 loginctl enable-linger <该用户>，否则服务随登出停止
DEPLOY_USER=

# SSH 端口（可选，默认 22）
DEPLOY_SSH_PORT=

# SSH 私钥路径（可选）；留空走 ssh agent 或默认密钥
DEPLOY_SSH_KEY=

# 目标机部署目录（可选，默认 ~/jianartifact）；发布位于其 releases/ 下，current 符号链接指向活动发布
DEPLOY_DIR=

# systemd 用户服务名（可选，默认 jianartifact）
DEPLOY_SERVICE=

# 就绪自检探活地址（可选）；必须是指向 /readyz 的完整 http:// 或 https:// URL，
# 部署与回滚后按状态码判定健康，失败自动回滚；留空时降级为仅检查服务 active 状态
DEPLOY_HEALTH_URL=

# 服务公网访问地址（可选）；部署成功且服务确认仍需初始化时，用于输出一次性设置链接
DEPLOY_PUBLIC_URL=

# SQLite 数据库路径（可选，默认 data/jianartifact.db）；相对路径以目标机部署目录为基准
DEPLOY_DATABASE_PATH=

# 目标机保留的发布份数（可选，默认 3）；活动发布与其上一版永不清理
DEPLOY_KEEP_RELEASES=
