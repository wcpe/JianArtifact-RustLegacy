# JianArtifact Linux 交叉编译镜像。
# 仅用于本地构建 Linux amd64 / arm64 发布包，不作为运行时镜像。
FROM rust:1.96.1-bookworm

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG NODE_VERSION=22.12.0
ARG PNPM_VERSION=9.15.9
ARG ZIG_VERSION=0.14.1
ARG CARGO_ZIGBUILD_VERSION=0.23.0

ENV CARGO_TERM_COLOR=always \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:/usr/local/bin:/opt/zig:${PATH}

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        xz-utils \
        git \
        build-essential \
        clang \
        cmake \
        make \
        perl \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
    | tar -xJ -C /usr/local --strip-components=1 \
    && npm install -g "pnpm@${PNPM_VERSION}"

# Zig 0.14.x 起压缩包命名 arch/os 顺序对调（zig-x86_64-linux-*，旧的 zig-linux-x86_64-* 已 404）
RUN curl -fsSL "https://ziglang.org/download/${ZIG_VERSION}/zig-x86_64-linux-${ZIG_VERSION}.tar.xz" \
    | tar -xJ -C /opt \
    && mv "/opt/zig-x86_64-linux-${ZIG_VERSION}" /opt/zig

RUN rustup component add rust-src \
    && rustup target add x86_64-unknown-linux-musl aarch64-unknown-linux-musl \
    && cargo install cargo-zigbuild --locked --version "${CARGO_ZIGBUILD_VERSION}"

# bash -l 登录 shell 经 /etc/profile 重置 PATH、丢掉 /usr/local/cargo/bin 与 /opt/zig，补 profile.d 脚本让 cargo 与 zig 在登录 shell 可见
RUN printf 'export PATH=/usr/local/cargo/bin:/opt/zig:$PATH\n' > /etc/profile.d/cargo.sh

WORKDIR /workspace
